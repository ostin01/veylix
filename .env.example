# Local-development defaults only. Production must inject these values securely.
POSTGRES_DB=veylix
POSTGRES_USER=veylix
POSTGRES_PASSWORD=veylix
DATABASE_URL=postgresql+psycopg://veylix:veylix@localhost:5432/veylix
DATABASE_URL_DOCKER=postgresql+psycopg://veylix:veylix@postgres:5432/veylix
TELEMETRY_MAX_ATTEMPTS=5
DEVICE_OFFLINE_AFTER_SECONDS=60
DEVICE_OFFLINE_CHECK_INTERVAL_SECONDS=10
JWT_SECRET_KEY_FILE=./secrets/jwt_secret_key
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
MQTT_CA_CERT_FILE=./secrets/mqtt/ca.crt
MQTT_SERVER_CERT_FILE=./secrets/mqtt/server.crt
MQTT_SERVER_KEY_FILE=./secrets/mqtt/server.key
MQTT_SIMULATOR_PASSWORD_FILE=./secrets/mqtt/simulator_password
MQTT_CONSUMER_PASSWORD_FILE=./secrets/mqtt/consumer_password
